# PDFSeal Environment Configuration Template
# Copy this file to .env.local to customize your deployment.
# In open-source / local dev, all official commercial links default to empty (pure local mode).

# -----------------------------------------------------------------------------
# 0. Site Public URL (SEO canonical / sitemap / OG image tags)
# -----------------------------------------------------------------------------
# Empty (default, clean self-host mode): build skips sitemap.xml & robots.txt,
# and strips domain-specific tags (canonical / og:url / og:image) from index.html.
# canonical & og:url are still generated at runtime from the actual visiting origin.
# og-image.png is a public brand asset committed to the repo (public/og-image.png);
# self-hosters may replace it with their own 1200x630 image if desired.
# VITE_OFFICIAL_URL=https://your-domain.com
VITE_OFFICIAL_URL=

# -----------------------------------------------------------------------------
# 1. Master Official Switch
# -----------------------------------------------------------------------------
# Set to 'true' to enable official branding, commercial portal, and community links.
# In production on pdf.sealkit.org, official mode is enabled automatically.
VITE_FORCE_OFFICIAL_MODE=false

# -----------------------------------------------------------------------------
# 2. Support & Donations (Coffee / Fish button)
# -----------------------------------------------------------------------------
# Leave empty to completely hide the donation button, even in official mode.
# Example: https://ko-fi.com/your-username
VITE_KOFI_URL=

# -----------------------------------------------------------------------------
# 3. Commercial & Enterprise Licensing (Pro Button & Modal)
# -----------------------------------------------------------------------------
# Leave empty to completely hide the Commercial / Pro button, even in official mode.
# Example LemonSqueezy checkout URLs:
VITE_PLAN_ANNUAL_URL=
VITE_PLAN_LIFETIME_URL=
VITE_ENTERPRISE_EMAIL=

# -----------------------------------------------------------------------------
# 4. Feedback & Bug Reporting
# -----------------------------------------------------------------------------
# Embed URL for feedback form (e.g. Tally form iframe URL)
# Leave empty to hide the feedback button.
VITE_FEEDBACK_URL=

# -----------------------------------------------------------------------------
# 5. Open Source Repository Link
# -----------------------------------------------------------------------------
# Leave empty to hide GitHub link in navbar and footer.
VITE_GITHUB_REPO_URL=
